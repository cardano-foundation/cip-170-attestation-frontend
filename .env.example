# Cardano Network Configuration
# Options: mainnet, preprod, preview (default network; Settings can override it until this value changes)
NEXT_PUBLIC_CARDANO_NETWORK=preprod
# Optional: leave empty for the public Blockfrost endpoint and explorer of the network above
NEXT_PUBLIC_CARDANO_BLOCKFROST_API_URL=
NEXT_PUBLIC_CARDANO_EXPLORER_PREFIX=

# Signify Service Configuration
# URL of your Signify KERI service
NEXT_PUBLIC_SIGNIFY_URL=http://localhost:3901
# KERIA boot interface (used to create the Veridian browser agent); defaults to port 3903 of the Signify URL
NEXT_PUBLIC_SIGNIFY_BOOT_URL=http://localhost:3903

# Blockfrost project ID used by default (a key entered in Settings overrides it).
# NEXT_PUBLIC_* values are compiled into the browser bundle: anyone using a deployed build can read this key.
# Only set it for local or private deployments, and use a key for the network above.
NEXT_PUBLIC_BLOCKFROST_PROJECT_ID=
